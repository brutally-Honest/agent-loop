{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/loop.sh *)",
      "Bash(./.claude/scripts/loop.sh *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)"
    ],
    "deny": [
      "Bash(*approve.sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Agent|Task",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh", "args": [], "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-prompt.sh", "args": [], "timeout": 30 }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "approve|plan|plan-feature|implement|amend",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-command.sh", "args": [], "timeout": 300 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|quick-builder|reviewer|planner|impact-analyst|spec-critic",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-agent-stop.sh", "args": [], "timeout": 900 }
        ]
      }
    ]
  }
}
